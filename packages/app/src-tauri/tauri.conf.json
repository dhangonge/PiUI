{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PiUI",
  "version": "0.6.21",
  "identifier": "com.piui.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PiUI",
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "notification": null
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/": ""
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
