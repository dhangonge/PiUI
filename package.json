{
  "name": "piui",
  "version": "0.6.21",
  "private": true,
  "type": "module",
  "description": "Pi coding agent client — OCUI visual shell + Pi-native runtime",
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package --error-on-fail false",
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @piui/server",
    "dev:server:pi": "node scripts/dev-server-pi.mjs",
    "pi-worker": "npm run pi-worker -w @piui/server --",
    "dev:host": "npm run dev -w @piui/server",
    "dev:app": "npm run dev -w @piui/app",
    "build": "npm run build -w @piui/protocol && npm run build -w @piui/pi-worker && npm run build -w @piui/server && npm run build -w @piui/app",
    "test": "node scripts/test-mock.mjs",
    "test:coverage": "node scripts/test-mock.mjs --coverage",
    "test:pi": "npm run test:pi -w @piui/app",
    "typecheck": "npm run build -w @piui/protocol && npm run build -w @piui/pi-worker && npm run typecheck -w @piui/server && npm run typecheck -w @piui/app",
    "lint": "npm run lint -w @piui/app && eslint .",
    "format": "npm run format -w @piui/app",
    "smoke:timeline": "node --import tsx scripts/smoke-timeline-order.mjs",
    "smoke:android-ui": "node --import tsx scripts/smoke-android-ui.mjs",
    "smoke": "npm run smoke:timeline && npm run smoke:android-ui",
    "format:check": "npm run format:check -w @piui/app",
    "preview": "npm run preview -w @piui/app",
    "check": "npm run lint && npm run test:run -w @piui/app && npm run build",
    "validate": "npm run check:docs && npm run conformance:sdk:check && npm run typecheck && npm run lint && npm test && npm run build",
    "conformance:sdk": "node scripts/sdk-conformance.mjs",
    "conformance:sdk:check": "node scripts/sdk-conformance.mjs --check-only",
    "check:docs": "node scripts/check-doc-consistency.mjs",
    "prepare:tauri-mobile-resources": "node scripts/prepare-tauri-mobile-resources.mjs",
    "install:test-extension": "node scripts/install-piui-test-extension.mjs",
    "tauri": "npm run tauri -w @piui/app --",
    "tauri:android:init": "npm run tauri:android:init -w @piui/app",
    "tauri:android:dev": "npm run tauri:android:dev -w @piui/app",
    "tauri:android:build": "npm run tauri:android:build -w @piui/app",
    "release:prepare": "npm run release:prepare -w @piui/app",
    "release:bump": "node packages/app/scripts/bump-version.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "patch-package": "8.0.1"
  },
  "overrides": {
    "fast-uri": "^3.1.8"
  }
}
